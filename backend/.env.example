PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/primemarket

# "local" (default, zero cost mock bucket on disk) or "s3" (real private bucket)
STORAGE_MODE=local

# Only needed when STORAGE_MODE=s3. Credentials come from the standard AWS
# chain (env vars below or ~/.aws/credentials). Never commit real values.
AWS_REGION=ap-south-1
S3_BUCKET=your-private-bucket-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
